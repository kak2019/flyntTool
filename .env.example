# 站点门禁密码（必填）
SITE_PASSWORD=change-me

# 阿里云百炼 API Key，用于 Qwen MT Flash
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxx

# 国内默认如下；国际站可改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PDF 扫描件 / 手写 OCR，可改成 qwen-vl-ocr-2025-11-20
DASHSCOPE_OCR_MODEL=qwen-vl-ocr-latest
