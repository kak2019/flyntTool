# 站点门禁密码（必填）
SITE_PASSWORD=change-me

# 阿里云百炼 API Key，用于 Qwen MT Flash
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxx

# 国内默认如下；国际站可改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# PDF 扫描件 / 手写 OCR，可改成 qwen-vl-ocr-2025-11-20
DASHSCOPE_OCR_MODEL=qwen-vl-ocr-latest

# 翻译页朗读，默认 qwen3-tts-flash / Cherry
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash
# DASHSCOPE_TTS_VOICE=Cherry

# 微信群码：覆盖 OSS 上的固定图片。密钥只放服务端。
# OSS_REGION 形如 oss-cn-hangzhou；OSS_PUBLIC_URL 可填 CDN 完整地址。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
OSS_OBJECT_KEY=wechat-group.png
# OSS_PUBLIC_URL=https://cdn.example.com/wechat-group.png
# https://sc3.ft07.com/  https://sct.ftqq.com/
SERVERCHAN_SENDKEY_SC3=
SERVERCHAN_SENDKEY=
