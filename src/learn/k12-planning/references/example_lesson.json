              "key": "p1"
            },
            {
              "type": "from_shared",
              "key": "p2"
            },
            {
              "type": "phase_header",
              "name": "课堂检测",
              "minutes": 5
            },
            {
              "type": "from_shared",
              "key": "exit_ticket"
            }
          ]
        },
        {
          "heading": "板书与作业",
          "blocks": [
            {
              "type": "paragraph",
              "text": "板书主线：转化图示 → 平行四边形面积 = 底×高 → 三角形面积 = 底×高÷2 → 底和高必须对应。"
            },
            {
              "type": "list",
              "label": "作业",
              "items": [
                "基础：完成两道不同朝向三角形面积题",
                "变式：判断给定底边对应的高",
                "开放：设计一个面积为24平方厘米的三角形并说明"
              ]
            }
          ]
        }
      ]
