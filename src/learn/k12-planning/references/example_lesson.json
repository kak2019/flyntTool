  "shared": {
    "education_stage": "小学",
    "grade": "五年级",
    "subject": "数学",
    "duration": 45,
    "curriculum_standard": "《义务教育数学课程标准（2022年版）》",
    "standard_basis": "发展几何直观、推理意识和应用意识；探索并掌握三角形面积计算方法，能解决相关实际问题。",
    "textbook": "教材版本与单元位置待教师核对",
    "core_task": {
      "teacher": "让学生独立尝试把三角形转化为已经会计算面积的图形。不要先给出拼摆方法。",
      "student": "选择一个三角形，通过剪拼、画图或推理，说明怎样求出它的面积。"
    },
    "data_table": {
      "type": "table",
      "headers": ["三角形", "底/cm", "高/cm"],
      "rows": [["A", "8", "6"], ["B", "5", "4"], ["C", "10", "3"]]
    },
    "p1": {
      "teacher": "关注学生是否使用对应底边上的高。",
      "student": "计算三角形 A、B、C 的面积，并写出计算过程。"
    },
    "p2": {
      "teacher": "追问面积不变的依据，不接受只报结论。",
      "student": "一个三角形的底扩大到原来的 2 倍，高不变，面积怎样变化？用公式或图说明理由。"
    },
    "exit_ticket": {
      "teacher": "独立完成。按“会找对应高并正确解释 / 计算正确但解释不清 / 底高对应或除以2有误”记录。",
      "student": "一块三角形标志牌的底是 12 cm，高是 7 cm。求面积，并用一句话解释为什么要除以 2。"
    },
    "look_fors": {
      "type": "list",
      "items": [
        "能把两个全等三角形拼成平行四边形",
        "能说清三角形与所拼图形的面积关系",
        "能找到指定底边对应的高",
        "能用新情境解释公式中的除以2"
      ]
    },
    "misconceptions": {
      "type": "table",
      "headers": ["具体表现", "可能原因", "教师追问"],
      "rows": [
        ["直接用底×高", "忽略两个三角形与平行四边形的倍数关系", "拼成的平行四边形包含几个这样的三角形？"],
        ["任取一条边作高", "没有建立底与高的对应关系", "这条高与所选底边垂直吗？"]
      ]
    }
  },
